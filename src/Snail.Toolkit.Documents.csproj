<Project Sdk="Snail.Sdk.Library">

  <PropertyGroup>
    <Description>Reads PDF, Word, Excel, PowerPoint, HTML, CSV, JSON, Markdown and text into one Markdown text with its pages, headings and tables.</Description>
    <PackageTags>snail;documents;pdf;docx;xlsx;pptx;html;csv;markdown;text-extraction</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Snail.Toolkit.Documents.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
